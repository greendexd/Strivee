generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  level     Int      @default(1)
  xp        Int      @default(0)
  gems      Int      @default(0)
  fire      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habits    Habit[]
  inventory Item[]
  duelsAsChallenger Duel[] @relation("Challenger")
  duelsAsOpponent   Duel[] @relation("Opponent")
  socialEvents      SocialEvent[]
}

model Habit {
  id        String   @id @default(uuid())
  title     String
  description String?
  type      String   // e.g., "step", "sleep", "custom"
  goal      Int
  streak    Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Duel {
  id           String   @id @default(uuid())
  challengerId String
  opponentId   String
  status       String   // e.g., "pending", "active", "completed"
  type         String   // e.g., "step_challenge"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  challenger User @relation("Challenger", fields: [challengerId], references: [id])
  opponent   User @relation("Opponent", fields: [opponentId], references: [id])
}

model Item {
  id        String   @id @default(uuid())
  name      String
  type      String   // e.g., "skin", "utility", "lootbox"
  rarity    String   // e.g., "common", "rare", "legendary"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model SocialEvent {
  id        String   @id @default(uuid())
  userId    String
  type      String   // e.g., "evolution", "streak"
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
